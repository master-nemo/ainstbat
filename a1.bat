cmd.exe /c "if exist "C:\1\instbat" (rmdir /s /q "C:\1\instbat") & mkdir "C:\1\instbat" && cd /d "C:\1\instbat" && powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -Uri 'https://github.com/master-nemo/ainstbat/archive/refs/heads/main.zip' -OutFile '_gist.zip'; Expand-Archive -Path '_gist.zip' -DestinationPath '.' -Force" && for /r %%i in (asetall.bat) do if exist "%%i" (cd /d "%%~dpi" && call "asetall.bat" & exit)"